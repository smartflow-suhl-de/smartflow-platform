# Caddy holt das Zertifikat automatisch, sobald SF_DOMAIN öffentlich auf diesen
# Host zeigt (ACME/HTTP-01). Für eine interne oder noch nicht aufgelöste Domain
# schlägt das fehl: dann in diesem Block `tls internal` ergänzen und mit
# `docker compose up -d --build caddy` neu bauen — ein reiner Neustart genügt
# nicht, weil diese Datei ins Image gebacken wird. Caddy nutzt dann seine eigene
# CA, deren Wurzelzertifikat die Clients einmalig importieren müssen.
{
	email {$SF_OPERATOR_EMAIL}
}

{$SF_DOMAIN} {
	encode zstd gzip

	# Ein Ziel, ein Origin: die API liefert die SPA unter `/` und `/assets/*`
	# selbst aus, Caddy reicht nur durch.
	reverse_proxy app:8790 {
		# Die Client-Adresse wird gesetzt, nicht angehängt: Caddy würde sonst
		# einen vom Client mitgeschickten `X-Forwarded-For`-Eintrag behalten, und
		# die Anwendung verlässt sich bei `SF_TRUST_PROXY=1` genau einen Hop weit
		# auf diesen Header (Rate-Limit pro IP).
		header_up X-Forwarded-For {remote_host}
	}
}
