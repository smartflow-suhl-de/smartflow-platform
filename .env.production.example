# Vorlage für den Docker-Betrieb: nach `.env` kopieren und ausfüllen.
#   cp .env.production.example .env
# Compose liest `.env` automatisch. Echte Werte gehören nie ins Repository.

# Domain, unter der die Plattform erreichbar ist. Muss auf den Host zeigen,
# damit Caddy ein Zertifikat ausstellen kann. Für eine interne Domain siehe den
# Hinweis in `Caddyfile` (`tls internal`).
# Beispiel: platform.example.com
SF_DOMAIN=platform.example.com

# Erster Operator-Account: wird beim ersten Start angelegt. Zugleich die
# Standard-Absenderadresse der Anmeldemail.
SF_OPERATOR_EMAIL=operator@example.com
SF_OPERATOR_NAME=Operator

# Optional: trace | debug | info | warn | error | fatal | silent
SF_LOG_LEVEL=info

# --- Mailversand (im Produktivbetrieb Pflicht) --------------------------------
# Ohne SMTP verschickt die Plattform keine Anmeldelinks, und ohne Anmeldelink
# kommt niemand hinein. Deshalb startet der Container nicht, wenn SF_SMTP_HOST
# fehlt.
# Submission-Port des Relays. 587 = STARTTLS (Empfehlung), 465 = implizites TLS.
SF_SMTP_HOST=smtp.example.com
SF_SMTP_PORT=587

# Zugangsdaten. Bevorzugt das Passwort über eine Datei einspielen und den Pfad
# hier eintragen (Docker-Secret, gemountete Datei); die Datei hat Vorrang vor
# SF_SMTP_PASS. Beide Varianten sind zulässig, aber nie eine halbe Kombination:
# ein Benutzer ohne Passwort oder ein Passwort ohne Benutzer bricht den Start ab.
SF_SMTP_USER=smartflow
SF_SMTP_PASS=
# SF_SMTP_PASS_FILE=/run/secrets/smtp_pass

# Absender der Anmeldemail. Leer = SF_OPERATOR_EMAIL. Ein Anzeigename ist
# erlaubt: "SmartFlow <noreply@example.com>".
SF_SMTP_FROM=
# Optional: Antwortadresse, z. B. der Betrieb.
SF_SMTP_REPLY_TO=
