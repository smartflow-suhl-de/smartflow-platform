# Vorlage für den Docker-Betrieb: nach `.env` kopieren und ausfüllen.
#   cp .env.production.example .env
# Compose liest `.env` automatisch. Echte Werte gehören nie ins Repository.

# Domain, unter der die Plattform erreichbar ist. Muss auf den Host zeigen,
# damit Caddy ein Zertifikat ausstellen kann. Für eine interne Domain siehe den
# Hinweis in `Caddyfile` (`tls internal`).
# Beispiel: platform.example.com
SF_DOMAIN=platform.example.com

# Erster Operator-Account: wird beim ersten Start angelegt.
SF_OPERATOR_EMAIL=operator@example.com
SF_OPERATOR_NAME=Operator

# Optional: trace | debug | info | warn | error | fatal | silent
SF_LOG_LEVEL=info