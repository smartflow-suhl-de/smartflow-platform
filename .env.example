SF_HOST=127.0.0.1
SF_PORT=8790
# In NODE_ENV=production Pflicht und muss https:// sein, sonst bricht der Start ab.
SF_PUBLIC_URL=http://127.0.0.1:5273
SF_DATA_DIR=./data
# Gebautes SPA, das die API unter / ausliefert. Leer = reine API, / antwortet 404.
SF_WEB_DIR=
SF_OPERATOR_EMAIL=operator@example.com
SF_OPERATOR_NAME=Operator
SF_DEV_MAGIC_LINK=1
SF_SECURE_COOKIES=0
SF_LOG_LEVEL=info
SF_TRUST_PROXY=0
SF_BODY_LIMIT=1048576
SF_RATE_LIMIT_ENABLED=1
SF_RATE_LIMIT_MAGIC_LINK=10
# Mailversand. Ohne SF_SMTP_HOST wird nichts verschickt und die API antwortet mit
# sent:false; im Entwicklungsmodus kommt der Link stattdessen im Response zurück.
# In NODE_ENV=production ist SF_SMTP_HOST Pflicht.
# SF_SMTP_HOST=smtp.example.com
# SF_SMTP_PORT=587
# SF_SMTP_SECURE=0
# SF_SMTP_USER=smartflow
# SF_SMTP_PASS=
# SF_SMTP_PASS_FILE=
# SF_SMTP_FROM=
# SF_SMTP_REPLY_TO=
