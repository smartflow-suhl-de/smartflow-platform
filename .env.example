SF_HOST=127.0.0.1
SF_PORT=8790
# In NODE_ENV=production Pflicht und muss https:// sein, sonst bricht der Start ab.
SF_PUBLIC_URL=http://127.0.0.1:5273
SF_DATA_DIR=./data
# Gebautes SPA, das die API unter / ausliefert. Leer = reine API, / antwortet 404.
SF_WEB_DIR=
# Die Ersteinrichtung legt den ersten Operator im Browser an; es gibt keine
# Konto-Variablen mehr.
SF_SECURE_COOKIES=0
SF_LOG_LEVEL=info
SF_TRUST_PROXY=0
SF_BODY_LIMIT=1048576
SF_RATE_LIMIT_ENABLED=1
SF_RATE_LIMIT_LOGIN=10

# LLM-Provider-Plugin. Anbieter selbst werden über die Oberfläche gepflegt.
# SF_LLM_ALLOW_HTTP=0
# Loopback nur fuer ein lokales Gateway freigeben (z. B. Sidecar).
# SF_LLM_ALLOW_LOOPBACK=0
# SF_LLM_MAX_TIMEOUT_MS=60000
# SF_LLM_RETENTION_DAYS=90
# Agent-Plugin. Das Modell kommt aus einem eigenen Provider-Plugin; hier steht
# nur, unter welchem API-Pfad der Agent es aufruft, plus seine eigenen Grenzen.
# SF_AGENT_PROVIDER_BASE=/api/v1/llm
# SF_AGENT_MAX_STEPS=4
# SF_AGENT_TIMEOUT_MS=30000
# SF_AGENT_BUDGET_MS=45000
# SF_AGENT_RETENTION_DAYS=90
# SF_AGENT_RATE_PER_MINUTE=10
# SF_AGENT_RATE_PER_DAY=200
