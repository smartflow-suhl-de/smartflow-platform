---
import { render } from 'astro:content';
import Site from '../layouts/Site.astro';
import site from '../../content/site.json';
import { type SitePage, hrefOf, loadPages, navOf } from '../lib/pages';

export async function getStaticPaths() {
  const pages = await loadPages();
  return pages
    .filter((entry) => entry.id !== 'index')
    .map((entry: SitePage) => ({
      params: { slug: entry.id.replace(/\/index$/, '') },
      props: { entry },
    }));
}

const pages = await loadPages();
const { entry } = Astro.props as { entry: SitePage };
const { Content } = await render(entry);
---

<Site
  title={entry.data.title}
  siteName={site.name}
  nav={navOf(pages)}
  current={hrefOf(entry)}
>
  <p class="kicker">{hrefOf(entry)}</p>
  <h1>{entry.data.title}</h1>
  <hr class="rule" />
  <div class="prose">
    <Content />
  </div>
</Site>