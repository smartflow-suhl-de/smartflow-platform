---
import { render } from 'astro:content';
import Site from '../layouts/Site.astro';
import site from '../../content/site.json';
import { hrefOf, loadPages, navOf } from '../lib/pages';

const pages = await loadPages();
const home = pages.find((entry) => entry.id === 'index');
const others = pages.filter((entry) => entry.id !== 'index');
const content = home ? await render(home) : null;
const Home = content?.Content ?? null;
---

<Site title={site.name} siteName={site.name} nav={navOf(pages)} current="/">
  <p class="kicker">Startseite</p>
  <h1>{home?.data.title ?? site.name}</h1>
  {
    Home ? (
      <div class="prose">
        <Home />
      </div>
    ) : (
      <p class="lede">{site.tagline}</p>
    )
  }
  {
    others.length > 0 ? (
      <div class="grid">
        {others.map((entry) => (
          <div class="card">
            <a href={hrefOf(entry)}>{entry.data.title}</a>
            <p>{hrefOf(entry)}</p>
          </div>
        ))}
      </div>
    ) : null
  }
</Site>