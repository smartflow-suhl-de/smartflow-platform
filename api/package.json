{
  "name": "@smartflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "plugins": "node scripts/build-plugin-registry.mjs",
    "dev": "npm run plugins && node --env-file-if-exists=../.env --import tsx --watch scripts/serve-api.ts",
    "start": "npm run plugins && node --env-file-if-exists=../.env --import tsx scripts/serve-api.ts",
    "typecheck": "npm run plugins && tsc --noEmit",
    "test": "npm run plugins && node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.5",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "sanitize-html": "^2.18.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^5.9.3"
  }
}
